# Development only. Scripts pass these variables to Compose and the backend.
ASO_DB_URL=jdbc:postgresql://localhost:5433/aso
ASO_DB_USER=aso
ASO_DB_PASSWORD=aso-local-only
ASO_PORT=8080
ASO_ADDRESS=127.0.0.1

# Provider bootstrap only: local Keycloak, NOT ASO runtime OIDC settings.
# Intentionally public, fictitious development credentials. Never use in production.
ASO_KEYCLOAK_PORT=8180
ASO_KEYCLOAK_ADMIN=idp-admin
ASO_KEYCLOAK_ADMIN_PASSWORD=idp-admin-local-only
# Realm user passwords and aso-web's secret are versioned in dev/keycloak/aso-dev-realm.json.
