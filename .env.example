# Development only. Scripts pass these variables to Compose and the backend.
ASO_DB_URL=jdbc:postgresql://localhost:5433/aso
ASO_DB_USER=aso
ASO_DB_PASSWORD=aso-local-only
ASO_PORT=8080
ASO_ADDRESS=127.0.0.1
# Per validated user, shared between browser REST and MCP. Single-process counters.
ASO_RATE_LIMIT_REQUESTS=600
ASO_RATE_LIMIT_WRITES=120
ASO_RATE_LIMIT_WINDOW=1m

# Provider bootstrap only: local Keycloak, NOT ASO runtime OIDC settings.
# Intentionally public, fictitious development credentials. Never use in production.
ASO_KEYCLOAK_PORT=8180
ASO_KEYCLOAK_ADMIN=idp-admin
ASO_KEYCLOAK_ADMIN_PASSWORD=idp-admin-local-only
# Realm user passwords and aso-web's secret are versioned in dev/keycloak/aso-dev-realm.json.

# ASO runtime identity: explicit local-only values. scripts/dev.sh selects development.
# Direct Gradle invocations do not load .env; export these values or explicitly select development.
ASO_OIDC_ISSUER=http://127.0.0.1:8180/realms/aso-dev
ASO_OIDC_WEB_CLIENT_ID=aso-web
ASO_OIDC_WEB_CLIENT_SECRET=aso-web-secret-local-only
ASO_PUBLIC_URL=http://127.0.0.1:8080
ASO_MCP_AUDIENCE=http://127.0.0.1:8080/mcp
ASO_OIDC_GROUPS_CLAIM=groups
ASO_OIDC_MEMBER_GROUP=aso-members
ASO_OIDC_ADMIN_GROUP=aso-admins

# Local embedding service only. Do not use a public/cloud provider URL.
ASO_EMBEDDING_ENABLED=true
ASO_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
ASO_EMBEDDING_ALLOWED_HOSTS=127.0.0.1,localhost,::1
ASO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
ASO_EMBEDDING_DIMENSIONS=1024
ASO_EMBEDDING_API_KEY=
ASO_EMBEDDING_PREPARATION_VERSION=qwen3-retrieval-v1
# Query/document prefixes and suffixes are configurable; see README.
ASO_EMBEDDING_BATCH_SIZE=8
ASO_EMBEDDING_MAX_INPUT_CHARACTERS=4000
ASO_EMBEDDING_MAX_QUERY_CHARACTERS=1000
ASO_EMBEDDING_MAX_DOCUMENT_CHUNKS=64
ASO_EMBEDDING_MAX_RESPONSE_BYTES=4000000
ASO_EMBEDDING_CONNECT_TIMEOUT=300ms
ASO_EMBEDDING_REQUEST_TIMEOUT=1200ms
ASO_EMBEDDING_INDEXING_TIMEOUT=30s
ASO_EMBEDDING_WORKER_BATCH_SIZE=10
ASO_EMBEDDING_RETRY_DELAY=5s
ASO_EMBEDDING_POLL_MILLIS=1000
ASO_SEARCH_MIN_SIMILARITY=0.45
