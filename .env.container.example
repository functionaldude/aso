# Docker runtime template. Copy to .env.container and replace every REPLACE_ME value.
# Plain KEY=value: no shell quotes, export, interpolation, or multiline values.
# This file is passed with docker run --env-file; it is NOT a build input.
# Do not enable the development profile. Use your own database and public OIDC registration.

# Required installation-specific database connection; use container-reachable addresses.
ASO_DB_URL=jdbc:postgresql://REPLACE_ME_DATABASE_HOST:5432/aso
ASO_DB_USER=REPLACE_ME_DATABASE_USER
ASO_DB_PASSWORD=REPLACE_ME_DATABASE_PASSWORD

# Required identity configuration. One public S256-PKCE client, no client secret. Issuer must also be reachable by the browser.
ASO_OIDC_ISSUER=https://REPLACE_ME_IDP_HOST/realms/REPLACE_ME_REALM
ASO_OIDC_CLIENT_ID=REPLACE_ME_CLIENT_ID
ASO_PUBLIC_URL=https://REPLACE_ME_ASO_HOST
ASO_MCP_AUDIENCE=https://REPLACE_ME_ASO_HOST/mcp
ASO_OIDC_GROUPS_CLAIM=groups
ASO_OIDC_MEMBER_GROUP=REPLACE_ME_MEMBER_GROUP
ASO_OIDC_ADMIN_GROUP=REPLACE_ME_ADMIN_GROUP
# Optional: jwt (default) or explicit Okta org compatibility; see docs/okta-registration.md.
ASO_OIDC_MCP_TOKEN_MODE=jwt

# Optional: image defaults to all interfaces; port changes also require matching -p.
ASO_ADDRESS=0.0.0.0
ASO_PORT=8080

# Optional Codex callback override. Unset/blank uses this default; register it once on the shared client.
ASO_CODEX_CALLBACK_URL=http://127.0.0.1:8766/callback

# Optional per-user limits, shared by browser REST and MCP; process-local counters.
ASO_RATE_LIMIT_REQUESTS=600
ASO_RATE_LIMIT_WRITES=120
ASO_RATE_LIMIT_WINDOW=1m

# Optional embeddings. Disabled by default; exact/lexical retrieval remains available.
# For the local provider: set true and replace base URL/allowed hosts with your private model host.
# The opt-in Vertex provider requires its model/batch/preparation settings too; see docs/cloud-run.md.
ASO_EMBEDDING_ENABLED=false
ASO_EMBEDDING_PROVIDER=local
# Required only for provider=vertex; uses Application Default Credentials, not an API key.
ASO_EMBEDDING_VERTEX_PROJECT=
ASO_EMBEDDING_VERTEX_LOCATION=europe-west1
ASO_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
ASO_EMBEDDING_ALLOWED_HOSTS=127.0.0.1,localhost,::1
ASO_EMBEDDING_MODEL=text-embedding-qwen3-embedding-0.6b
ASO_EMBEDDING_DIMENSIONS=1024
ASO_EMBEDDING_API_KEY=
ASO_EMBEDDING_PREPARATION_VERSION=qwen3-retrieval-v1
# Leave prefixes unset to preserve the model's defaults. For multiline values,
# mount a Spring configuration file as shown in README; literal \n is not decoded here.
# ASO_EMBEDDING_QUERY_PREFIX=Retrieve related engineering questions. Query:
# ASO_EMBEDDING_QUERY_SUFFIX=
# ASO_EMBEDDING_DOCUMENT_PREFIX=
# ASO_EMBEDDING_DOCUMENT_SUFFIX=
ASO_EMBEDDING_MAX_INPUT_CHARACTERS=4000
ASO_EMBEDDING_MAX_QUERY_CHARACTERS=1000
ASO_EMBEDDING_MAX_DOCUMENT_CHUNKS=64
ASO_EMBEDDING_BATCH_SIZE=8
ASO_EMBEDDING_MAX_RESPONSE_BYTES=4000000
ASO_EMBEDDING_CONNECT_TIMEOUT=300ms
ASO_EMBEDDING_REQUEST_TIMEOUT=1200ms
ASO_EMBEDDING_INDEXING_TIMEOUT=30s
ASO_EMBEDDING_WORKER_BATCH_SIZE=10
ASO_EMBEDDING_RETRY_DELAY=5s
ASO_EMBEDDING_POLL_MILLIS=1000
ASO_SEARCH_MIN_SIMILARITY=0.45
